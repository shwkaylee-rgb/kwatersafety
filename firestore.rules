rules_version = '2';
// Firestore 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 파일 내용을 그대로 붙여넣고 [게시]를 누르세요.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // 관리자: admins 컬렉션에 자기 UID 문서가 있는 사람 (콘솔에서만 추가 가능)
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // 회원 정보: 본인과 관리자만 조회, 본인만 수정·탈퇴
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'birth', 'agreePrivacy', 'over14', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && (!('birth' in request.resource.data) || (request.resource.data.birth is string && request.resource.data.birth.size() <= 10));
      allow delete: if isOwner(uid);

      // 장바구니: 본인만
      match /cart/{itemId} {
        allow read, write: if isOwner(uid);
      }
      // 알림 읽음 기록 등 본인 설정: 본인만
      match /state/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // 알림: 관리자 처리 시 생성. 본인은 읽기, 읽음 표시, (탈퇴 시) 삭제만
    match /notifications/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      // 관리자, 또는 본인이 수신 설정을 바꿀 때의 처리 결과 알림(type: consent)
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.type == 'consent');
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    // 전체 공지 알림: 로그인 회원 읽기, 관리자만 쓰기
    match /broadcasts/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // 소식지 수신 동의: 본인만 설정, 관리자는 명단 조회
    match /marketingConsents/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'sms', 'agreedAt', 'confirmedAt', 'updatedAt'])
        && request.resource.data.email is bool && request.resource.data.sms is bool;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // 사전 설문(건강 문진표, 민감정보): 본인이 자기 신청서에 대해 제출·수정, 관리자만 모두 조회·삭제
    match /surveys/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.consentSensitive == true
        && id == request.resource.data.applicationId + '_' + request.resource.data.programId
        && get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid
        && request.resource.data.consentSensitive == true
        && request.resource.data.applicationId == resource.data.applicationId
        && request.resource.data.programId == resource.data.programId;
      allow delete: if isAdmin();
    }

    // 자료실 목록·제휴 할인 소개: 로그인 회원 읽기, 관리자만 쓰기
    // (파일 내용과 할인 코드는 서버 함수가 등급을 확인한 뒤에만 전달)
    match /resources/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /partners/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /partnerCodes/{id} {
      allow read, write: if isAdmin();
    }
    // 1:1 문의: 본인 작성·조회·삭제, 관리자는 답변만 기록
    match /inquiries/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == '접수'
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'category', 'title', 'body', 'status', 'createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 3000;
      allow update: if isAdmin()
        && request.resource.data.status in ['접수', '답변완료']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answer', 'answeredAt', 'answeredBy']);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    // 관리자 활동 기록: 관리자가 자기 이름으로 추가만. 고치거나 지울 수 없음
    match /adminLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'action', 'target', 'detail', 'at'])
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    // 매일 안내 발송 기록: 서버 함수만 씀
    match /reminderLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- 생존수영 능력 인증 ----------
    function swimGroup(groupId) { return get(/databases/$(database)/documents/swimGroups/$(groupId)).data; }
    function swimEvaluator(groupId) { return signedIn() && request.auth.uid in swimGroup(groupId).evaluatorUids; }

    // 학교·기관 수업: 등록 링크로 누구나 볼 수 있음, 관리자만 만들고 고침
    match /swimGroups/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // 학생 등록: 보호자(또는 만 14세 이상 본인)가 등록 받는 수업에만 등록. 평가 결과·인증번호는 강사·관리자만
    match /swimStudents/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid) || swimEvaluator(resource.data.groupId);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'registered'
        && request.resource.data.keys().hasOnly(['uid', 'groupId', 'name', 'birth', 'grade', 'registrant', 'consentAt', 'status', 'createdAt'])
        && swimGroup(request.resource.data.groupId).regOpen == true
        && swimGroup(request.resource.data.groupId).status == 'open';
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'registered'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'birth', 'grade', 'updatedAt']))
        || (swimEvaluator(resource.data.groupId) && swimGroup(resource.data.groupId).status == 'open'
            && resource.data.status != 'issued'
            && request.resource.data.status in ['registered', 'evaluated']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['results', 'evaluatedBy', 'evaluatedAt', 'status']));
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'registered');
    }
    // 보호자 연락처: 등록한 본인과 관리자만 (평가 강사는 볼 수 없음)
    match /swimContacts/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/swimStudents/$(id)).data.uid == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
    // 평가 강사 명단: 본인 확인용 읽기, 관리자만 지정
    match /evaluators/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }
    // 설정 (새 수업의 기본 평가 항목, 첫 화면 팝업 등). 팝업은 로그인 없이도 보여야 해서 공개
    match /settings/{id} {
      allow read: if signedIn() || id == 'popup';
      allow write: if isAdmin();
    }

    // 간편 로그인 연결 (네이버 고유ID → 회원 계정): 서버 함수만 만듦. 본인은 보기와 탈퇴 시 삭제만
    match /socialLinks/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if false;
    }

    // 게시판: 누구나 읽기, 관리자만 쓰기
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();

      // 댓글: 누구나 읽기, 로그인 회원 작성, 본인·관리자 삭제
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
        allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
        allow update: if false;
      }
    }

    // 교육·자격 과정: 누구나 읽기, 관리자만 쓰기
    match /programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- 대면 교육 이수 결과 ----------
    // 관리자가 이수·미이수, 점수, 이수번호를 기록. 회원은 자기 결과만 조회
    match /completions/{completionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ---------- 협회 자격 ----------
    // 자격 원장: 관리자만 발급·수정. 회원은 자기 자격만 조회
    match /qualifications/{certNo} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }
    // 공개 자격 확인: 문서 ID가 sha256(자격번호|성명)이라 둘 다 알아야 한 건만 조회 가능. 목록 조회는 막음
    match /qualVerify/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // ---------- 온라인 학습 ----------
    // 수강 중(수료 포함)이고 수강 기간 안인지
    function enrolledNow(courseId) {
      let path = /databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId);
      return signedIn() && exists(path)
        && get(path).data.status in ['active', 'passed']
        && request.time < get(path).data.endAt;
    }

    // 과정 정보: 누구나 읽기, 관리자만 쓰기
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
      // 챕터 본문(영상·글): 수강 중인 회원과 관리자만
      match /chapters/{chapterId} {
        allow read: if isAdmin() || enrolledNow(courseId);
        allow write: if isAdmin();
      }
    }

    // 평가 문제·정답: 관리자만 (회원은 서버 함수로만 응시)
    match /courseExams/{courseId} {
      allow read, write: if isAdmin();
    }

    // 수강 정보: 관리자가 승인 시 생성. 본인은 수강 기간 안에 진도만 기록 가능. 합격 기록은 서버 함수만
    match /enrollments/{enrollmentId} {
      // 문서 ID가 '내 UID_과정ID'이면 아직 수강 기록이 없어도 조회 가능 (없음을 확인하려고)
      allow get: if isAdmin() || (signedIn() && enrollmentId.matches(request.auth.uid + '_.+'));
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.status == 'active'
            && request.time < resource.data.endAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress', 'lastStudiedAt']));
    }

    // 응시 기록: 본인·관리자 읽기, 쓰기는 서버 함수만
    match /examAttempts/{attemptId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // 멤버십(회원 자격): 본인과 관리자만 조회, 관리자만 수정 (입금 확인 후 활성화)
    match /memberships/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // 회원번호 일련번호: 관리자만
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // 멤버십 신청서: 본인 제출, '접수' 상태에서 본인 취소만 가능. 심사·활성화·증빙 발급은 관리자
    match /membershipApplications/{appId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == '접수'
        && request.resource.data.kind in ['join', 'renew', 'upgrade']
        && request.resource.data.tier in ['general', 'full']
        && request.resource.data.fee is int && request.resource.data.fee >= 0
        && request.resource.data.receiptStatus in ['none', '대기']
        && !('adminMemo' in request.resource.data)
        && !('receiptNo' in request.resource.data)
        && !('memberNo' in request.resource.data);
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.status == '접수'
            && request.resource.data.status == '취소'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isAdmin();
    }

    // 신청서: 본인과 관리자만 조회. 본인은 제출과 '접수완료' 상태에서 취소만 가능
    match /applications/{appId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == '접수완료'
        && !('adminMemo' in request.resource.data)
        && !('receiptNo' in request.resource.data)
        && (!('receiptStatus' in request.resource.data) || request.resource.data.receiptStatus in ['none', '대기']);
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.status == '접수완료'
            && request.resource.data.status == '취소'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isAdmin();
    }
  }
}
